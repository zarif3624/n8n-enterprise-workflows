{
  "name": "n8n-enterprise-workflows",
  "version": "0.2.0",
  "private": true,
  "description": "Production-minded n8n workflow templates for enterprise teams.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-workflows.mjs",
    "evaluate": "node scripts/evaluate-policy.mjs",
    "catalog": "node scripts/catalog-cli.mjs",
    "contracts": "node scripts/contract-registry-cli.mjs",
    "mapping": "node scripts/field-mapping-cli.mjs",
    "conformance": "node scripts/conformance-cli.mjs",
    "conformance:compare": "node scripts/conformance-compare-cli.mjs",
    "smoke:webhook": "node scripts/smoke-test-webhook.mjs",
    "compatibility": "node scripts/runtime-compatibility-cli.mjs",
    "lifecycle": "node scripts/policy-lifecycle-cli.mjs",
    "readiness": "node scripts/readiness-report-cli.mjs",
    "validate": "node scripts/validate-workflows.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "scan:sensitive": "node scripts/scan-sensitive-data.mjs",
    "validate:policy-versions": "node scripts/verify-policy-versions.mjs",
    "report:policy-changes": "node scripts/report-policy-changes.mjs",
    "report:policy-impact": "node scripts/report-policy-impact.mjs",
    "build:release": "node scripts/build-release.mjs",
    "verify:bundle": "node scripts/verify-bundle-cli.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:adversarial": "node --test tests/adversarial-inputs.test.mjs",
    "check": "npm run generate && npm run validate && npm run contracts -- validate && npm run compatibility -- validate && npm run lifecycle -- validate && npm run validate:links && npm run scan:sensitive && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
