{
  "name": "n8n-enterprise-workflows",
  "version": "0.2.0",
  "private": true,
  "description": "Production-minded n8n workflow templates for enterprise teams.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-workflows.mjs",
    "evaluate": "node scripts/evaluate-policy.mjs",
    "smoke:webhook": "node scripts/smoke-test-webhook.mjs",
    "validate": "node scripts/validate-workflows.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:policy-versions": "node scripts/verify-policy-versions.mjs",
    "report:policy-changes": "node scripts/report-policy-changes.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run generate && npm run validate && npm run validate:links && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
