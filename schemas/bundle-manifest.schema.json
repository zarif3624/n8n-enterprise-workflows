{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zarif3624/n8n-enterprise-workflows/main/schemas/bundle-manifest.schema.json",
  "title": "n8n Enterprise Workflows Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleManifestVersion", "packageVersion", "scope",
    "sourceArtifactManifestSha256", "workflows", "fileCount", "files"
  ],
  "properties": {
    "bundleManifestVersion": { "const": 1 },
    "packageVersion": { "$ref": "#/$defs/semver" },
    "scope": { "type": "string", "enum": ["full", "department"] },
    "department": { "$ref": "#/$defs/slug" },
    "sourceArtifactManifestSha256": { "$ref": "#/$defs/sha256" },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workflow" }
    },
    "fileCount": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "safePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["department", "slug", "name", "policyVersion", "workflow"],
      "properties": {
        "department": { "$ref": "#/$defs/slug" },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "policyVersion": { "$ref": "#/$defs/semver" },
        "workflow": { "type": "string", "pattern": "^workflows/[a-z0-9-]+/[a-z0-9-]+/workflow\\.json$" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
