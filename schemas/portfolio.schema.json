{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zarif3624/n8n-enterprise-workflows/main/schemas/portfolio.schema.json",
  "title": "n8n Enterprise Workflows Open-core Portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": ["portfolioVersion", "model", "allocation", "sourceLineage", "publicLineage", "privateLineage", "selectionCriteria", "publicWorkflows", "historicalRemovals", "communitySurface", "productBoundary", "historicalNotice"],
  "properties": {
    "portfolioVersion": { "const": 2 },
    "model": { "const": "open-core" },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluatedWorkflowFamilies", "openSource", "commercialReserve", "openSourcePercent", "commercialReservePercent"],
      "properties": {
        "evaluatedWorkflowFamilies": { "const": 64 },
        "openSource": { "const": 16 },
        "commercialReserve": { "const": 48 },
        "openSourcePercent": { "const": 25 },
        "commercialReservePercent": { "const": 75 }
      }
    },
    "sourceLineage": { "$ref": "#/$defs/sourceLineage" },
    "publicLineage": { "$ref": "#/$defs/publicLineage" },
    "privateLineage": { "$ref": "#/$defs/privateLineage" },
    "selectionCriteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
          "description": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "publicWorkflows": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["department", "slug", "rationale", "learningValue"],
        "properties": {
          "department": { "$ref": "#/$defs/slug" },
          "slug": { "$ref": "#/$defs/slug" },
          "rationale": { "$ref": "#/$defs/nonEmpty" },
          "learningValue": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "historicalRemovals": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["department", "slug", "status", "removedIn"],
        "properties": {
          "department": { "$ref": "#/$defs/slug" },
          "slug": { "$ref": "#/$defs/slug" },
          "status": { "const": "never-approved-draft" },
          "removedIn": { "const": "0.3.0" }
        }
      }
    },
    "communitySurface": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "productBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservedWorkflowFamilies", "implementationLocation", "includes"],
      "properties": {
        "reservedWorkflowFamilies": { "const": 48 },
        "implementationLocation": { "const": "outside-public-repository" },
        "includes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "historicalNotice": { "$ref": "#/$defs/nonEmpty" }
  },
  "$defs": {
    "sourceLineage": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceDerivedFamilies", "newerNamedConcepts"],
      "properties": { "evidenceDerivedFamilies": { "const": 31 }, "newerNamedConcepts": { "const": 33 } }
    },
    "publicLineage": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceDerivedFamilies", "newerNamedConcepts"],
      "properties": { "evidenceDerivedFamilies": { "const": 4 }, "newerNamedConcepts": { "const": 12 } }
    },
    "privateLineage": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceDerivedFamilies", "newerNamedConcepts"],
      "properties": { "evidenceDerivedFamilies": { "const": 27 }, "newerNamedConcepts": { "const": 21 } }
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "nonEmpty": { "type": "string", "minLength": 1 }
  }
}
