{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zarif3624/n8n-enterprise-workflows/main/schemas/field-mapping.schema.json",
  "title": "n8n Enterprise Workflow Field Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappingVersion", "workflow", "policyFingerprint", "fields"],
  "properties": {
    "mappingVersion": { "const": 1 },
    "workflow": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "policyFingerprint": { "$ref": "#/$defs/sha256" },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "pattern": "^/" },
        "transform": {
          "type": "string",
          "enum": ["identity", "trim", "uppercase", "lowercase", "finiteNumber", "strictBoolean"]
        }
      }
    }
  }
}
