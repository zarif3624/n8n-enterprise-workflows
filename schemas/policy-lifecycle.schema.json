{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zarif3624/n8n-enterprise-workflows/main/schemas/policy-lifecycle.schema.json",
  "title": "n8n Enterprise Workflow Policy Lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["lifecycleVersion", "defaultReviewPeriodDays", "defaultDraftApprovalDays", "policies"],
  "properties": {
    "lifecycleVersion": { "const": 1 },
    "defaultReviewPeriodDays": { "type": "integer", "minimum": 30, "maximum": 365 },
    "defaultDraftApprovalDays": { "type": "integer", "minimum": 1, "maximum": 90 },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "owner", "status", "reviewDueOn"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["draft", "active", "deprecated"] },
        "introducedOn": { "$ref": "#/$defs/date" },
        "lastReviewedOn": { "$ref": "#/$defs/date" },
        "reviewDueOn": { "$ref": "#/$defs/date" },
        "deprecation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["announcedOn", "sunsetOn"],
          "properties": {
            "announcedOn": { "$ref": "#/$defs/date" },
            "sunsetOn": { "$ref": "#/$defs/date" },
            "replacementSlug": { "$ref": "#/$defs/slug" }
          }
        }
      }
    }
  }
}
