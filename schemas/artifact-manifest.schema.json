{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zarif3624/n8n-enterprise-workflows/main/schemas/artifact-manifest.schema.json",
  "title": "n8n Enterprise Workflows Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion", "packageVersion", "policySchemaVersion",
    "policyEngineVersion", "policyEngineFingerprint", "artifactCount",
    "departmentCount", "workflowCount", "artifacts"
  ],
  "properties": {
    "manifestVersion": { "const": 1 },
    "packageVersion": { "$ref": "#/$defs/semver" },
    "policySchemaVersion": { "$ref": "#/$defs/semverCore" },
    "policyEngineVersion": { "$ref": "#/$defs/semver" },
    "policyEngineFingerprint": { "$ref": "#/$defs/sha256" },
    "artifactCount": { "type": "integer", "minimum": 1 },
    "departmentCount": { "type": "integer", "minimum": 1 },
    "workflowCount": { "type": "integer", "minimum": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "kind": {
            "type": "string",
            "enum": [
              "api-contract", "catalog", "catalog-documentation", "contract-registry",
              "fixture-high-risk", "fixture-invalid", "fixture-low-risk",
              "json-schema", "policy-lifecycle", "policy-lock",
              "policy-snapshot", "portfolio", "runtime-compatibility", "workflow",
              "workflow-documentation"
            ]
          },
          "department": { "$ref": "#/$defs/slug" },
          "workflow": { "$ref": "#/$defs/slug" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "semverCore": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
