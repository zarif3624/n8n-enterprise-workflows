{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zarif3624/n8n-enterprise-workflows/main/schemas/policy-snapshot.schema.json",
  "title": "n8n Enterprise Workflow Policy Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotVersion", "policySchemaVersion", "policyEngineVersion", "policyEngineFingerprint", "policies"],
  "properties": {
    "snapshotVersion": { "const": 1 },
    "policySchemaVersion": { "$ref": "#/$defs/semverCore" },
    "policyEngineVersion": { "$ref": "#/$defs/semver" },
    "policyEngineFingerprint": { "$ref": "#/$defs/sha256" },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "semverCore": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
    "fieldContract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "boolean" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "number" },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minLength", "maxLength"],
          "properties": {
            "type": { "const": "string" },
            "minLength": { "type": "integer", "minimum": 0 },
            "maxLength": { "type": "integer", "minimum": 1 },
            "format": { "type": "string", "enum": ["email", "date-time"] },
            "pattern": { "type": "string", "minLength": 1 },
            "allOf": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pattern"],
                "properties": { "pattern": { "const": "\\S" } }
              }
            },
            "enum": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
          }
        }
      ]
    },
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required", "properties", "additionalProperties"],
      "properties": {
        "type": { "const": "object" },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/fieldContract" }
        },
        "additionalProperties": { "const": true }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "points", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "field": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "operator": { "type": "string", "enum": ["missing", "truthy", "falsy", "equals", "includes", "gt", "gte", "lt"] },
        "value": { "type": ["string", "number", "boolean"] },
        "points": { "type": "number" },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "minimumBand": { "type": "string", "enum": ["medium", "high"] }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policySchemaVersion", "policyEngineVersion", "department", "slug",
        "inputSchema", "rules", "thresholds", "decisions", "actions"
      ],
      "properties": {
        "policySchemaVersion": { "$ref": "#/$defs/semverCore" },
        "policyEngineVersion": { "$ref": "#/$defs/semver" },
        "department": { "$ref": "#/$defs/slug" },
        "slug": { "$ref": "#/$defs/slug" },
        "inputSchema": { "$ref": "#/$defs/inputSchema" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["medium", "high"],
          "properties": {
            "medium": { "type": "number", "minimum": 0, "maximum": 100 },
            "high": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "medium", "high"],
          "properties": {
            "low": { "$ref": "#/$defs/decision" },
            "medium": { "$ref": "#/$defs/decision" },
            "high": { "$ref": "#/$defs/decision" }
          }
        },
        "actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["department", "slug", "name", "owner", "policyVersion", "fingerprint", "behavior"],
      "properties": {
        "department": { "$ref": "#/$defs/slug" },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "policyVersion": { "$ref": "#/$defs/semver" },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "behavior": { "$ref": "#/$defs/behavior" }
      }
    }
  }
}
