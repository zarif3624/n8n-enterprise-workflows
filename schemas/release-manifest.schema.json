{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zarif3624/n8n-enterprise-workflows/main/schemas/release-manifest.schema.json",
  "title": "n8n Enterprise Workflows Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseManifestVersion", "packageVersion", "sourceArtifactManifestSha256", "archiveCount", "archives"],
  "properties": {
    "releaseManifestVersion": { "const": 1 },
    "packageVersion": { "$ref": "#/$defs/semver" },
    "sourceArtifactManifestSha256": { "$ref": "#/$defs/sha256" },
    "archiveCount": { "type": "integer", "minimum": 1 },
    "archives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "scope", "workflowCount", "bytes", "sha256"],
        "properties": {
          "file": { "type": "string", "pattern": "^n8n-enterprise-workflows(?:-[a-z0-9-]+)?-v[0-9]+\\.[0-9]+\\.[0-9]+\\.tar\\.gz$" },
          "scope": { "type": "string", "enum": ["full", "department"] },
          "department": { "$ref": "#/$defs/slug" },
          "workflowCount": { "type": "integer", "minimum": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
