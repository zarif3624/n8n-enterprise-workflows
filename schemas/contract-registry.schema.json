{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zarif3624/n8n-enterprise-workflows/main/schemas/contract-registry.schema.json",
  "title": "n8n Enterprise Workflows Contract Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "documents", "outputs"],
  "properties": {
    "registryVersion": { "const": 1 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "schema"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/jsonPath" },
          "schema": { "$ref": "#/$defs/schemaPath" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "schema", "producer"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "schema": { "$ref": "#/$defs/schemaPath" },
          "producer": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "jsonPath": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*\\.json$" },
    "schemaPath": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$" }
  }
}
