[
  {
    "schemaVersion": "1.0",
    "policyVersion": "1.0.1",
    "department": "finance",
    "slug": "invoice-exception-triage",
    "name": "Triage enterprise invoice exceptions",
    "summary": "Scores invoice exceptions and routes clean invoices, finance reviews, and payment holds through a consistent policy.",
    "outcome": "A structured decision with a risk score, matched policy reasons, and the next recommended action.",
    "owner": "Accounts Payable Operations",
    "metric": "Minutes of manual review avoided per invoice",
    "inputSchema": {
      "type": "object",
      "required": [
        "invoiceId",
        "vendorId",
        "amount",
        "currency"
      ],
      "properties": {
        "invoiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "vendorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "minLength": 3,
          "maxLength": 3
        },
        "purchaseOrderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "duplicateDetected": {
          "type": "boolean"
        },
        "amountMismatchPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "restrictedVendor": {
          "type": "boolean"
        },
        "newBankDetails": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "decisions": {
      "low": "continue_standard_processing",
      "medium": "route_to_finance_review",
      "high": "hold_payment_and_escalate"
    },
    "adapters": [
      "SAP",
      "Oracle",
      "NetSuite",
      "Coupa",
      "Slack"
    ],
    "path": "workflows/finance/invoice-exception-triage",
    "endpoint": "/webhook/enterprise/finance/invoice-exception-triage",
    "workflow": "workflows/finance/invoice-exception-triage/workflow.json",
    "examples": {
      "lowRisk": "workflows/finance/invoice-exception-triage/examples/low-risk.json",
      "highRisk": "workflows/finance/invoice-exception-triage/examples/high-risk.json",
      "invalid": "workflows/finance/invoice-exception-triage/examples/invalid.json"
    }
  },
